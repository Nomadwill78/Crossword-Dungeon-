; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wordsmith's Gambit"
run/main_scene="res://src/scenes/main_menu/MainMenuScene.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

ConfigLoader="*res://src/autoload/ConfigLoader.gd"
EventBus="*res://src/autoload/EventBus.gd"
GameState="*res://src/autoload/GameState.gd"
SaveManager="*res://src/autoload/SaveManager.gd"
AssetRegistry="*res://src/autoload/AssetRegistry.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
